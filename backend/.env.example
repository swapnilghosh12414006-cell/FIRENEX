# Default checkpoint path; override with an absolute path if needed.
FIRE_MODEL_PATH=./models/fire-smoke.pt
FIRE_MODEL_DEVICE=cpu
FIRE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIRE_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(:\d+)?$
FIRE_MAX_UPLOAD_MB=25
FIRE_MAX_VIDEO_MB=200

# Required to unlock the dashboard. Set a private password with at least 12 characters.
EMBERWATCH_ADMIN_USERNAME=
EMBERWATCH_ADMIN_PASSWORD=
EMBERWATCH_SESSION_TTL_HOURS=8
# On an HTTPS deployment set secure=true. For cross-site frontend/API hosting,
# also set samesite=none and configure FIRE_ALLOWED_ORIGINS for the frontend.
# EMBERWATCH_COOKIE_SECURE=true
# EMBERWATCH_COOKIE_SAMESITE=lax

# Configure TLS-protected SMTP to enable opt-in email notifications.
# Example for Gmail: create a Google App Password (not your account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-account@gmail.com
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false
# For implicit TLS providers, use their host/port, SMTP_USE_SSL=true, SMTP_STARTTLS=false.

# WebRTC signaling is hosted by this FastAPI process. Camera media travels peer-to-peer.
# STUN helps direct connections; configure TURN for reliable connections across restrictive networks.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.example.org:3478,turns:turn.example.org:5349
# Coturn REST API shared secret; the backend derives room-expiring credentials.
# WEBRTC_TURN_SHARED_SECRET=
# WEBRTC_TURN_USERNAME=emberwatch

# Require this many consecutive positive webcam/video frames before logging an incident.
FIRE_CONFIRMATION_FRAMES=2

# Optional shared secret required by POST /api/sensors when set.
# SENSOR_API_KEY=replace-with-a-long-random-value

# Optional persistent database location; defaults to backend\data\emberwatch.sqlite3.
# EMBERWATCH_DATABASE=
